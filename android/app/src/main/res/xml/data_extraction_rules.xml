<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Every file Flourish keeps is personal financial
     data or a credential that cannot be restored elsewhere: the SQLite
     ledger (app_flutter/flourish.db), its automatic JSON backups
     (app_flutter/backups), receipt photos (app_flutter/receipt-*), the
     captured-alert queue (files/detection), saved alert keys and widget
     snapshots (shared_prefs), and API keys whose Android Keystore keys never
     leave the device (shared_prefs/FlutterSecureStorage.xml).

     None of it goes to Google cloud backup or to a new phone through
     device-to-device transfer. People move their data with the encrypted
     backup in Wealth > Tools instead. Changing these rules does not touch
     data already on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
