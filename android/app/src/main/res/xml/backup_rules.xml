<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (API 30-). Backup is already off through
     android:allowBackup="false"; these rules keep every domain excluded if
     that flag is ever turned back on. See data_extraction_rules.xml for
     what each location holds. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
